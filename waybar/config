{
    "layer": "top",
    "position": "top",
    "height": 12,
    "margin": 0,

    "modules-left": ["pulseaudio"],
    "modules-center": ["clock"],
    "modules-right": ["memory", "cpu"],

    "pulseaudio": {
        "format": "  {volume}%",
        "format-muted": "󰖁 mute",
        "scroll-step": 5,
        "on-click": "pactl set-sink-mute alsa_output.pci-0000_01_00.1.hdmi-stereo toggle"
    },

    "clock": {
        "format": "{:%H:%M}"
    },

    "memory": {
        "interval": 11,
        "format": "  {used:0.1f}G"
    },

    "cpu": {
        "interval": 5,
        "format": "  {usage}%"
    }
}
