{
"layer": "top",
"position": "top",
"height": 18,
"margin": 0,
"width": 1900,

"modules-left": ["pulseaudio"],
"modules-center": ["clock"],
"modules-right": ["memory", "cpu"],
},

"pulseaudio": {
    "format": "♫ {volume}%",
    "scroll-step": 5,
    "on-click": "pactl set-sink-mute alsa_output.pci-0000_01_00.1.hdmi-stereo toggle"
},

"clock": {
"format": "{:%H:%M}"
},

"memory": {
    "format": "{used:0.1f}G"
},

"cpu": {
"format": "{usage}%"
}
}
