{
    "layer": "top",
    "position": "top",
    "height": 13,
    "margin": 0,

    "modules-left": ["pulseaudio"],
    "modules-center": ["clock"],
    "modules-right": ["custom/mem", "cpu"],

    "pulseaudio": {
        "format": " {volume}%",
        "format-muted": "󰖁 mute",
        "scroll-step": 5,
        "on-click": "pactl set-sink-mute alsa_output.pci-0000_01_00.1.hdmi-stereo toggle"
    },

    "clock": {
        "format": "{:%H:%M}"
    },

    "custom/mem": {
        "exec": "~/.config/waybar/mem.sh",
        "interval": 3
    },
     
    "cpu": {
        "interval": 3,
        "format": " {usage}%"
    }
}
